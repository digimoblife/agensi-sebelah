{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agensi-sebelah.local/schemas/kpi_snapshot.v1.schema.json",
  "title": "KPI Snapshot",
  "description": "Angka yang dihitung kode (T0, SQL) dari metrics_daily. <= 30 baris. Report Writer hanya menulis narasi di atasnya; tidak boleh menghitung ulang.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "period", "rows"],
  "properties": {
    "meta": { "$ref": "_common.v1.schema.json#/$defs/meta" },
    "period": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "compare_from", "compare_to"],
      "properties": {
        "from": { "$ref": "_common.v1.schema.json#/$defs/date" },
        "to": { "$ref": "_common.v1.schema.json#/$defs/date" },
        "compare_from": { "$ref": "_common.v1.schema.json#/$defs/date" },
        "compare_to": { "$ref": "_common.v1.schema.json#/$defs/date" }
      }
    },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_key", "source", "value", "previous", "change_pct"],
        "properties": {
          "metric_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,50}$" },
          "label": { "type": "string", "maxLength": 60 },
          "source": { "type": "string", "enum": ["instagram", "facebook", "tiktok", "ga4", "gsc", "gbp", "first_party", "manual"] },
          "value": { "type": "number" },
          "previous": { "type": ["number", "null"] },
          "change_pct": { "type": ["number", "null"] },
          "target": { "type": ["number", "null"], "description": "Dari kpi_goals (F9.8)." },
          "is_primary_goal": { "type": "boolean", "default": false }
        }
      }
    },
    "top_content": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["content_item_id", "metric_key", "value"],
        "properties": {
          "content_item_id": { "type": "integer" },
          "metric_key": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    },
    "data_quality": {
      "type": "array", "maxItems": 10,
      "description": "Peringatan dari monitor kualitas data, mis. sumber tidak tertarik.",
      "items": { "type": "string", "maxLength": 160 }
    }
  }
}
