APP_NAME="Agensi Sebelah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088
APP_TIMEZONE_DISPLAY=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Match the container user to the host user (run `id -u` / `id -g`).
HOST_UID=501
HOST_GID=20

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agensi
DB_USERNAME=agensi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

GOTENBERG_URL=http://gotenberg:3000

# Outgoing clients. "fake" is refused in production. Real credentials are NOT set here:
# they are entered in the dashboard (Pengaturan > Kredensial, docs/specs/credentials-settings.md).
LLM_PROVIDER=real
TELEGRAM_CLIENT=real
PUBLISHER=real
RENDERER=real

# Instagram fetches images by public URL. Leave empty to publish via ready-to-upload packages only.
# With a tunnel pointed at 127.0.0.1:8089 (media-only), set e.g. https://media.yourdomain.com
PUBLIC_MEDIA_BASE_URL=
MEDIA_PORT=8089

MAIL_MAILER=log
